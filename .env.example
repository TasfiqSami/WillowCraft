# Public site branding. Update src/config.js for the server facts and detailed content.
SITE_NAME=WillowCraft
SITE_TAGLINE=Find your place in the wild
SITE_DESCRIPTION=A magical Minecraft SMP experience. Explore custom biomes, build your legacy, and join a cozy community on WillowCraft.

# Runtime settings. The local Windows launcher sets HOST and PORT for localhost.
HOST=127.0.0.1
PORT=4173

